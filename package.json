{
  "name": "bvs-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "start": "node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "deploy": "npm run check && npm run build && wrangler deploy --profile bvs",
    "check": "node --check public/app.js && node --check scripts/serve.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "wrangler": "4.131.2"
  }
}
