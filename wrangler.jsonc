{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bvs-site",
  "account_id": "9911a722a68019be6a9a09ea0c589a26",
  "compatibility_date": "2026-09-14",
  "main": "./src/worker.js",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  }
}
